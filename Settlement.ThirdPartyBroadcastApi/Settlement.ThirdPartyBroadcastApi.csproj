    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="1.0.1" />
    <PackageReference Include="Fanex.Settlement.ScaleOut" Version="1.3.3" />
    <PackageReference Include="Kaden.XmlConverter" Version="2.0.0" />
    <PackageReference Include="MediatR" Version="11.1.0" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="11.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Hosting" Version="2.2.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.5" />
    <PackageReference Include="System.Text.Encodings.Web" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThirdPartyBroadcast\ThirdPartyBroadcast.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\email-templates\credit-template.html" />
  </ItemGroup>

</Project>
