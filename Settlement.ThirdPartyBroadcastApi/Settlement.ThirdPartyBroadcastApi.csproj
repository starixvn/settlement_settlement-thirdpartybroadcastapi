<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SonarQubeExclude>True</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="AutoMapper" Version="12.0.1" />

    <PackageReference Include="Fanex.Data" Version="4.2.3" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.2.3" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.3" />
    <!-- ReSharper disable once VulnerablePackage -->
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="1.0.1" />
    <PackageReference Include="Fanex.Settlement.Converter" Version="1.0.0.1" />
    <PackageReference Include="Fanex.Settlement.ScaleOut" Version="1.3.6" />
    <PackageReference Include="MassTransit" Version="8.1.0" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.1.0" />
    <PackageReference Include="MediatR" Version="12.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Encodings.Web" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThirdPartyBroadcast\ThirdPartyBroadcast.csproj" />
  </ItemGroup>

</Project>
